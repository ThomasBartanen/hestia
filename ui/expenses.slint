import { DatePickerPopup, Button, LineEdit } from "std-widgets.slint";
import { Date, MessageType, ExpenseInfo, ExpenseData } from "globals.slint";

export component AddExpense inherits Rectangle {
    width: 400px;
    height: 300px;

    in-out property <ExpenseInfo> new-expense;

    public function clear-expense-menu() {
        prop_id.text = "";
        expense_type.text = "";
        expense_amount.text = "";
        month.text = "";
        day.text = "";
        year.text = "";
        expense_description.text = "";
    }

    expense-added := PopupWindow {
        Text {
            text: "Succesfully Added Expense";
        }
    }

    VerticalLayout {
        spacing: 10px;
        padding: 20px;
        /*
        id: int,
        prop-id: int,
        expense-type: string,
        amount: float,
        date: string,
        description: string,
        */

        prop_id := LineEdit {
            placeholder-text: "Associated Property";
            input-type: number;
            width: 100%;
        }

        expense_type := LineEdit {
            placeholder-text: "Expense Type";
            width: 100%;
        }

        expense_amount := LineEdit {
            placeholder-text: "Amount";
            input-type: number;
            width: 100%;
        }

        expense_dates := Rectangle {
            in-out property <Date> date;
            popup := DatePickerPopup {
                accepted(date) => {
                    month.text = date.month;
                    day.text = date.day;
                    year.text = date.year;
                    popup.close();
                }
            }
            HorizontalLayout {
                width: parent.width;
                month := LineEdit {
                    placeholder-text: "Month";
                    input-type: InputType.number;
                    width: 30%;
                }
                day := LineEdit {
                    placeholder-text: "Day";
                    input-type: InputType.number;
                    width: 30%;
                }
                year := LineEdit {
                    placeholder-text: "Year";
                    input-type: InputType.number;
                    width: 30%;
                }
                picker := Button {
                    width: 10%;
                    clicked => {
                        popup.show();
                    }                
                }
            }
        }

        expense_description := LineEdit {
            placeholder-text: "Description";
            width: 100%;
        }

        HorizontalLayout {
            spacing: 10px;

            Button {
                text: "Add";
                clicked => {
                    ExpenseData.new-expense(
                        MessageType.create,
                        {
                            id: -1,
                            prop-id: -1,
                            expense-type: expense_type.text,
                            amount: expense_amount.text.to-float(),
                            date: {
                                month: month.text.to-float(), 
                                day: day.text.to-float(), 
                                year: year.text.to-float(),
                            },
                            description: expense_description.text
                        }
                    );

                    clear-expense-menu();

                    expense-added.show();
                }
            }

            Button {
                text: "Cancel";
                clicked => {
                    // Add logic to handle canceling the action
                    //console.log("Add Expense Canceled");
                    clear-expense-menu();
                }
            }
        }
    }
}