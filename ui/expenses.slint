import { TabWidget, LineEdit, GridBox, ComboBox, SpinBox, StandardButton, ListView, Button, StandardTableView, ScrollView, VerticalBox } from "std-widgets.slint";
import { Validation, IdType } from "validation.slint";
import { BufferLine, TableText, TableHeader, TableItemActionIcons, CreationActionIcons, TableItem } from "custom_widgets.slint";
import { PeriodType, ExpenseData, ExpenseInput, MessageType } from "globals.slint";

enum ExpenseMenuState {totals, view}

export component MainExpenseView inherits Rectangle {
    Rectangle {
        Text {
            text: "Number of Expenses: " + ExpenseData.expenses.length;
        }
    }

    visualizations := Rectangle {
        VerticalLayout {
            HorizontalLayout {
                period-selection := ComboBox {
                    max-height: 10px;
                    property <PeriodType> period-selected;
                    model: [
                        "Current Day",
                        "Current Week",
                        "Current Month",
                        "YTD",
                        "Custom"
                    ];
                }
            }
            Rectangle {
                GridLayout {
                    Rectangle {
                        col: 0;
                        row: 0;
                        Text {
                            text: "";
                        }
                    }
                    Rectangle {
                        col: 1;
                        row: 0;
                        Text {
                            text: "";
                        }
                    }
                    Rectangle {
                        col: 0;
                        row: 1;
                        Text {
                            text: "";
                        }
                    }
                    Rectangle {
                        col: 1;
                        row: 1;
                        Text {
                            text: "Total: " + ExpenseData.get-totals(period-selection.period-selected);
                        }
                    }
                }
            }
        }
        Rectangle {}

        Rectangle {}
    }
}

export component ViewExpenseTotalsMenu inherits Rectangle {
    in-out property <ExpenseInput> selected-expense;
    in-out property <string> expense-subtype-string;
    in-out property <MessageType> expense-action;
    y: 10px;
    x: 20px;
    padding: 10px;
    VerticalLayout {
        x: 30px;
        titles := HorizontalLayout {
            TableHeader { 
                width: 40px;
                text: "ID";
            }
            TableHeader { 
                width: 40px;
                text: "Property";
            }
            TableHeader { 
                width: 100px;
                text: "Date";
            }
            TableHeader { 
                width: 150px;
                text: "Description";
            }
            TableHeader { 
                width: 150px;
                text: "Expense Type";
            }
            TableHeader { 
                width: 150px;
                text: "Expense Subtype";
            }
            TableHeader { 
                width: 70px;
                text: "Amount";
            }
        }
        BufferLine { 
            buffer: 10px;
            line-thickness: 3px;
        }
        ScrollView {
            VerticalLayout {
                alignment: LayoutAlignment.start;
                preferred-width: 0in;
                x: 0cm;
                padding: 0;
                for x in ExpenseData.expenses: expense-line := HorizontalLayout {
                    expense-id := TableItem {
                        width: 40px;
                        text: x.id;
                    }
                    expense-prop-id := TableItem {
                        width: 40px;
                        text: x.prop-id;
                        //TODO: Translate prop id to property name. Maybe use combobox for the edit section
                    }
                    expense-date := TableItem { 
                        width: 100px;
                        text: x.date;
                    }
                    expense-description := TableItem { 
                        width: 150px;
                        text: x.description;
                    }
                    TableItem {
                        width: 150px;
                        text: x.expense-type;
                    }
                    TableItem {
                        width: 150px;
                        text: x.expense-subtype;               
                    }
                    expense-amount := TableItem { 
                        width: 70px;
                        text: x.amount;
                    }
                    expense-action-icons := TableItemActionIcons {
                        width: 70px;
                        edit => {
                            selected-expense = x;
                            new-expense.current-use = MessageType.update;

                            new-expense-id.edit-text = x.id;
                            new-expense-prop-id.edit-text = x.prop-id;
                            new-expense-description.edit-text = x.description;
                            new-expense-date.edit-text = x.date;
                            new-expense-amount.edit-text = x.amount;
                            new-expense-type.current-value = x.expense-type;
                            new-expense-subtype.current-value = x.expense-subtype;
                        }
                        delete => {
                            ExpenseData.selected-expense-id = x.id;
                            expense-action = MessageType.delete;
                            selected-expense = x;

                            ExpenseData.new-expense(
                                expense-action,
                                {
                                id: ExpenseData.selected-expense-id,
                                description: x.description,
                                amount: x.amount,
                                date: x.date,
                                expense-type: x.expense-type,
                                expense-subtype: x.expense-subtype
                            });
                        }
                    }
                }
            }
        }
        BufferLine { 
            buffer: 10px;
            line-thickness: 3px;
        }
        Rectangle {
            new-expense := HorizontalLayout {
                out property <MessageType> current-use;
                new-expense-id := TableText {                        
                    width: 40px;
                    default-text: "";
                }
                new-expense-prop-id := TableText {
                    width: 40px;
                    default-text: "Property";
                }
                new-expense-date := TableText { 
                    width: 100px;
                    default-text: "Date";
                }
                new-expense-description := TableText { 
                    width: 150px;
                    default-text: "Description";
                }
                Rectangle {
                    width: 150px;
                    new-expense-type := ComboBox {
                        width: parent.width;
                        model: [
                            "Select Expense Type", 
                            "Utilities", 
                            "Maintenance", 
                            "Other"
                        ];
                        current-index: 0;
                    }
                }
                Rectangle {
                    width: 150px;
                    new-expense-subtype := ComboBox {
                        width: parent.width;
                        model: [""];
                        current-index: 0;
                        enabled: true;
                        states [
                            Utility when new-expense-type.current-value == "Utilities": {
                                enabled: true;
                                new-expense-subtype.model: [
                                    "Water",
                                    "Electricity",
                                    "Garbage",
                                    "Gas",
                                    "Other"
                                ];
                            }
                            Maintenance when new-expense-type.current-value == "Maintenance": {
                                enabled: true;
                                new-expense-subtype.model: [
                                    "Repairs",
                                    "Cleaning",
                                    "Landscaping",
                                    "Other"
                                ];
                            }
                            None when new-expense-type.current-value != "Utilities" && new-expense-type.current-value != "Maintenance" : {
                                new-expense-subtype.enabled : false;
                            }
                        ]
                    }                        
                }
                new-expense-amount := TableText { 
                    width: 70px;
                    default-text: "Amount";
                }
                new-expense-action-icons := CreationActionIcons {
                    width: 70px;
                    confirm => {
                        
                        ExpenseData.new-expense(
                            new-expense.current-use,
                            {
                            id: new-expense.current-use == MessageType.update ?
                                selected-expense.id :
                                Validation.get-valid-id(IdType.Expense),
                            prop-id: new-expense-prop-id.edit-text.to-float(),
                            description: new-expense-description.edit-text,
                            amount: new-expense-amount.edit-text.to-float(),
                            date: new-expense-date.edit-text,
                            expense-type: new-expense-type.current-value,
                            expense-subtype: new-expense-subtype.current-value
                        });
                    }
                    cancel => {
                        new-expense.current-use = MessageType.create;

                        new-expense-id.clear();
                        new-expense-prop-id.clear();
                        new-expense-description.clear();
                        new-expense-amount.clear();
                        new-expense-date.clear();
                        new-expense-type.current-value = "Select Expense Type";
                        new-expense-subtype.current-index = 0;
                    }
                }
            }
        }
        Rectangle {
            height: 10px;
        }
    }
}

export component ExpenseMenu inherits Rectangle {
    HorizontalLayout {
        Rectangle {
            min-width: 400px;
            preferred-width: 600px;
            max-width: 1000px;
            property <ExpenseMenuState> current-state: ExpenseMenuState.totals;
            VerticalLayout {
                states [
                    View when current-state == ExpenseMenuState.view : {
                        view-totals-menu.visible : false;
                        main-view-menu.visible : true;
                    }
                    Totals when current-state == ExpenseMenuState.totals : {
                        view-totals-menu.visible : true;
                        main-view-menu.visible : false;
                    }
                ]
                HorizontalLayout {
                    Button {
                        text: "Expenses";
                        clicked => {
                            current-state = ExpenseMenuState.totals;
                        }
                    }
                    Button {
                        text: "Visualizations";
                        clicked => {
                            current-state = ExpenseMenuState.view;
                        }
                    }
                }
                Rectangle {
                    main-view-menu := MainExpenseView {
                        visible: false;
                    }
                    view-totals-menu := ViewExpenseTotalsMenu {
                        visible: false;
                    }
                }                
            }
        }
    }
}