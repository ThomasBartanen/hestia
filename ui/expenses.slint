import { DatePickerPopup, Button, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { Date, MessageType, ExpenseInfo, ExpenseData } from "globals.slint";
import { TableHeader, BufferLine, TableItem, TableItemActionIcons, TableText, TableDate, CreationActionIcons } from "custom_widgets.slint";
import { IdType, Validation } from "validation.slint";

export component ExpenseList inherits Rectangle {
    in-out property <MessageType> message-type;
    x: 20px;
    padding: 10px;
    VerticalLayout {
        x: 30px;
        titles := HorizontalLayout {
            TableHeader {
                width: 40px;
                text: "ID";
            }
            TableHeader {
                width: 40px;
                text: "Property";
            }
            TableHeader {
                width: 100px;
                text: "Date";
            }
            TableHeader { 
                width: 150px;
                text: "Description";
            }
            TableHeader { 
                width: 150px;
                text: "Expense Type";
            }
            TableHeader { 
                width: 150px;
                text: "Expense Subtype";
            }
            TableHeader { 
                width: 70px;
                text: "Amount";
            }
        }
        BufferLine { 
            buffer: 10px;
            line-thickness: 3px;
        }
        ScrollView {
            VerticalLayout {
                alignment: LayoutAlignment.start;
                preferred-width: 0in;
                x: 0cm;
                padding: 0;
                for x in ExpenseData.expenses: expense-line := HorizontalLayout {
                    expense-id := TableItem {
                        width: 40px;
                        text: x.id;
                    }
                    expense-prop-id := TableItem {
                        width: 40px;
                        text: x.prop-id;
                        //TODO: Translate prop id to property name. Maybe use combobox for the edit section
                    }
                    expense-date := TableItem { 
                        width: 100px;
                        text: @tr("{}/{}/{}", x.date.month, x.date.day, x.date.year);
                    }
                    expense-description := TableItem { 
                        width: 150px;
                        text: x.description;
                    }
                    TableItem {
                        width: 150px;
                        text: x.expense-type;
                    }
                    expense-amount := TableItem { 
                        width: 70px;
                        text: x.amount;
                    }
                    expense-action-icons := TableItemActionIcons {
                        width: 70px;
                        edit => {
                            ExpenseData.selected-id = x.id;
                            message-type = MessageType.update;

                            id.edit-text = x.id;
                            prop-id.edit-text = x.prop-id;
                            description.edit-text = x.description;
                            date.set-date(x.date);
                            amount.edit-text = x.amount;
                            type.edit-text = x.expense-type;
                        }
                        delete => {
                            ExpenseData.selected-id = x.id;
                            message-type = MessageType.delete;

                            ExpenseData.new-expense(
                                message-type,
                                {
                                    id: ExpenseData.selected-id,
                                    description: x.description,
                                    amount: x.amount,
                                    date: x.date,
                                    expense-type: x.expense-type,
                                },
                            );
                        }
                    }
                }
            }
        }
        BufferLine { 
            buffer: 10px;
            line-thickness: 3px;
        }
        Rectangle {
            new-expense := HorizontalLayout {
                out property <MessageType> current-use;
                id := TableText {                        
                    width: 40px;
                    default-text: "";
                }
                prop-id := TableText {
                    width: 40px;
                    default-text: "Property";
                }
                date := TableDate { 
                    width: 40px;
                    default-text: "Date";
                }
                description := TableText { 
                    width: 150px;
                    default-text: "Description";
                }
                type := TableText {
                    width: 150px;
                    default-text: "Expense Type";
                }
                amount := TableText { 
                    width: 70px;
                    default-text: "Amount";
                }
                action-icons := CreationActionIcons {
                    width: 70px;
                    confirm => {
                        
                        ExpenseData.new-expense(
                            new-expense.current-use,
                            {
                                id: new-expense.current-use == MessageType.update ?
                                    ExpenseData.selected-id :
                                    Validation.get-valid-id(IdType.Expense),
                                prop-id: prop-id.edit-text.to-float(),
                                description: description.edit-text,
                                amount: amount.edit-text.to-float(),
                                date: date.current-date,
                                expense-type: type.edit-text,
                            }
                        );
                    }
                    cancel => {
                        new-expense.current-use = MessageType.create;

                        id.clear();
                        prop-id.clear();
                        description.clear();
                        amount.clear();
                        date.clear();
                        type.clear();
                    }
                }
            }
        }
        Rectangle {
            height: 10px;
        }
    }
}

export component AddExpense inherits Rectangle {
    width: 400px;
    height: 300px;

    in-out property <ExpenseInfo> new-expense;

    public function clear-expense-menu() {
        prop_id.text = "";
        expense_type.text = "";
        expense_amount.text = "";
        month.text = "";
        day.text = "";
        year.text = "";
        expense_description.text = "";
    }

    expense-added := PopupWindow {
        Text {
            text: "Succesfully Added Expense";
        }
    }

    VerticalLayout {
        spacing: 10px;
        padding: 20px;
        /*
        id: int,
        prop-id: int,
        expense-type: string,
        amount: float,
        date: string,
        description: string,
        */

        prop_id := LineEdit {
            placeholder-text: "Associated Property";
            input-type: number;
            width: 100%;
        }

        expense_type := LineEdit {
            placeholder-text: "Expense Type";
            width: 100%;
        }

        expense_amount := LineEdit {
            placeholder-text: "Amount";
            input-type: number;
            width: 100%;
        }

        expense_dates := Rectangle {
            in-out property <Date> date;
            popup := DatePickerPopup {
                accepted(date) => {
                    month.text = date.month;
                    day.text = date.day;
                    year.text = date.year;
                    popup.close();
                }
            }
            HorizontalLayout {
                width: parent.width;
                month := LineEdit {
                    placeholder-text: "Month";
                    input-type: InputType.number;
                    width: 30%;
                }
                day := LineEdit {
                    placeholder-text: "Day";
                    input-type: InputType.number;
                    width: 30%;
                }
                year := LineEdit {
                    placeholder-text: "Year";
                    input-type: InputType.number;
                    width: 30%;
                }
                picker := Button {
                    width: 10%;
                    clicked => {
                        popup.show();
                    }                
                }
            }
        }

        expense_description := LineEdit {
            placeholder-text: "Description";
            width: 100%;
        }

        HorizontalLayout {
            spacing: 10px;

            Button {
                text: "Add";
                clicked => {
                    ExpenseData.new-expense(
                        MessageType.create,
                        {
                            id: -1,
                            prop-id: -1,
                            expense-type: expense_type.text,
                            amount: expense_amount.text.to-float(),
                            date: {
                                month: month.text.to-float(), 
                                day: day.text.to-float(), 
                                year: year.text.to-float(),
                            },
                            description: expense_description.text
                        }
                    );

                    clear-expense-menu();

                    expense-added.show();
                }
            }

            Button {
                text: "Cancel";
                clicked => {
                    // Add logic to handle canceling the action
                    //console.log("Add Expense Canceled");
                    clear-expense-menu();
                }
            }
        }
    }
}