export global ColorPalette {
    in-out property <color> button-default : #cfcd9cc5;
    in-out property <color> button-hovered : #45805d;
    in-out property <color> button-pressed : #ffa0a0;
    in-out property <color> button-border;
    in-out property <color> icon-bg;
    in-out property <color> window-bg : #ffedc4;
}