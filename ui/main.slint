import { VerticalBox, HorizontalBox, ComboBox } from "std-widgets.slint";
import { TenantInfo, TenantData } from "globals.slint";

export { TenantInfo, TenantData }

export enum PageType { Home, Expenses, Tenants, Properties, Settings }

export component NavigationPane inherits Rectangle {
    in-out property <string> current-page: "Home";
    in-out property <PageType> current-page-type: Home;
    
    callback change-page(PageType);
    width: 60px;
    Rectangle {
        background: green;
        VerticalLayout {
            alignment: LayoutAlignment.start;
            padding: 10px;
            spacing: 10px;
            TouchArea {
                Text {
                    text : "Properties";
                }
                clicked => {
                    current-page = "Properties";
                    current-page-type = PageType.Properties;
                    change-page(PageType.Properties);
                }
            }
            TouchArea {
                Text {
                    text : "Tenants";
                }
                clicked => {
                    current-page = "Tenants";                    
                    current-page-type = PageType.Tenants;
                    change-page(PageType.Tenants);
                }
            }
            TouchArea {
                Text {
                    text : "Expenses";
                }
                clicked => {
                    current-page = "Expenses";
                    current-page-type = PageType.Expenses;
                    change-page(PageType.Expenses);
                }
            }
            TouchArea {
                Text {
                    text : "Settings";
                }
                clicked => {
                    current-page = "Settings";
                    current-page-type = PageType.Settings;
                    change-page(PageType.Settings);
                }
            }
        }
    }
}

export component App inherits Window {    
    // function that sets the info rects to visible when selecting new page type?
    function OpenContent(page: PageType) {
        expense-info.visible = false;
        prop-info.visible = false;
        tenant-info.visible = false;
        settings-info.visible = false;

        if current-page-type == PageType.Expenses {
            expense-info.visible = true;
        }
        if current-page-type == PageType.Properties {
            prop-info.visible = true;
        }
        if current-page-type == PageType.Tenants {
            tenant-info.visible = true;
        }
        if current-page-type == PageType.Settings {
            settings-info.visible = true;
        }
    }

    // === Window ===
    title: "Hestia";
    //always-on-top: true;
    //no-frame: true;

    // === Sizing ===
    min-width: 400px;
    preferred-width: 800px;
    min-height: 300px;
    preferred-height: 1000px;

    // === Elements ===
    padding: 10px;

    in-out property <PageType> current-page-type <=> nav-pane.current-page-type;

    callback change-page <=> nav-pane.change-page;
    
    HorizontalLayout {
        nav-pane := NavigationPane { }
        content-pane := Rectangle {             
            background: grey;
            
            Text {
                y: 20px;
                height: 40px;
                text: "Current Page is: " + nav-pane.current-page;
            }

            info-rect := Rectangle {
                expense-info := Rectangle {
                    x: 10px;
                    y: 10px;
                    visible: false;
                    Text {
                        text: "1";
                    }
                }
                prop-info := Rectangle {
                    x: 10px;
                    y: 10px;
                    visible: false;
                    Text {
                        text: "2";
                    }
                }
                tenant-info := Rectangle {
                    x: 10px;
                    y: 10px;
                    visible: false;
                    Text {
                        text: "3";
                    }
                }
                settings-info := Rectangle {
                    x: 10px;
                    y: 10px;
                    visible: false;
                    Text {
                        text: "4";
                    }
                } 
            }
        }
    }

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New");
                activated => { }
            }
        }
        Menu {
            title: @tr("Add");
            MenuItem {
                title: @tr("Property");
                activated => { }
            }
        }
        Menu {
            title: @tr("View");
        }
        Menu {
            title: @tr("Help");
        }
    }
}