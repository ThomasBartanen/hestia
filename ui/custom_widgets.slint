import { ScrollView, LineEdit } from "std-widgets.slint";
import { ColorPalette } from "palette.slint";

export component BufferLine {
    in-out property <physical-length> buffer;
    in-out property <physical-length> line-thickness;
    max-height: buffer;
    VerticalLayout {
        Rectangle {}        
        Rectangle {
            height: line-thickness;
            background: black;
        }
        Rectangle {}
    }
}


export component TableHeader inherits Rectangle {
    in-out property <string> text;
    in-out property <length> text-size: 9px;
    pure callback on-sort-clicked(int);
    HorizontalLayout {
        width: parent.width;
        header-title := Text {
            font-size: text-size;
            text: text;
            horizontal-alignment: TextHorizontalAlignment.center;
            vertical-alignment: TextVerticalAlignment.center;
            wrap: TextWrap.word-wrap;
        }
        sorting-icon := TouchArea {
            Image {
                
            }
        }
    }
}

export component TableItem inherits Rectangle {
    border-color: black.transparentize(0.8);
    border-width: 1px;
    border-top-right-radius: 3px;
    in-out property <string> text <=> text-line.text;
    text-line := Text {
        x: 5px;
        width: parent.width;
        horizontal-alignment: TextHorizontalAlignment.left;
    }
}

export component TableText inherits TouchArea {
    public function clear() {
        edit-text = "";
    }
    in-out property <string> default-text <=> text-line.placeholder-text;
    in-out property <string> edit-text <=> text-line.text;
    Rectangle {
        x: 5px;
        width: parent.width;
        border-color: black;
        border-top-right-radius: 3px;
        text-line := LineEdit {
            width: parent.width;
            horizontal-alignment: TextHorizontalAlignment.left;
        }
    }
}

export component ActionIcon inherits TouchArea {
    in-out property <string> name;
    Rectangle {
        background: parent.pressed ? ColorPalette.button-pressed : 
                    parent.has-hover ? ColorPalette.button-hovered : 
                    ColorPalette.button-default;
        border-radius: 3px;
        Text {
            color: black;
            font-size: 10px;
            text: name;
        }
    }
}

export component TableItemActionIcons inherits Rectangle {
    callback edit();
    callback delete();
    GridLayout {
        padding: 5px;
        edit-row := ActionIcon {
            name: "Edit";
            col: 0;
            row: 0;
            clicked => {
                edit();
            }
        }
        delete-row := ActionIcon {
            name: "Delete";
            col: 1;
            row: 0;
            clicked => {
                delete();
            }
        }
    }
}

export component CreationActionIcons inherits Rectangle {
    callback confirm();
    callback cancel();
    GridLayout {
        padding: 5px;
        confirm-item := ActionIcon {
            name: "Confirm";
            col: 0;
            row: 0;
            clicked => {
                confirm();
            }
        }
        cancel-row := ActionIcon {
            name: "Cancel";
            col: 1;
            row: 0;
            clicked => {
                cancel();
            }
        }
    }
}
