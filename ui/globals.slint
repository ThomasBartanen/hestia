export enum MessageType {create, update, delete}
export enum PeriodType {Day, Month, YTD, Complete}
export enum WindowType {Lessee, Property, Settings}

export struct Date {
    month: int,
    day: int,
    year: int
}

// ==========================================
// ============== Tenants ===================
// ==========================================
export struct TenantInfo {
    id: int,
    name: string,
    lease: int,
    property-id: int,
    email: string,
    phone-number: string,
    move-in-date: string,
}

export global TenantData {
    callback new-tenant(MessageType, TenantInfo);

    in-out property <[TenantInfo]> tenants;
    in-out property <int> selected-id;
}

// ==========================================
// ============== Transactions ==============
// ==========================================
export struct TransactionInfo {
    id: int,
    prop-id: int,
    transaction-type: string,
    amount: float,
    date: Date,
    description: string,
}

export global RegisterData {
    callback new-transaction(MessageType, TransactionInfo);

    in-out property <[TransactionInfo]> transactions;
    in-out property <int> selected-id;
}

// ==========================================
// ============== Properties ================
// ==========================================
export struct PropertyInfo {
    id: int,
    name: string,
    address: string,
    unit-ids: [int]
}
export global PropertyData {
    callback new-prop(MessageType, PropertyInfo);

    in-out property <[PropertyInfo]> props;
    in-out property <int> selected-id;
}

// ==========================================
// ============== Units =====================
// ==========================================
export struct UnitInfo {
    id: int
}

export global UnitData {
    callback new-unit(MessageType, UnitInfo);

    in-out property <[UnitInfo]> units;
    in-out property <int> selected-id;
}


// ==========================================
// ============== Settings ==================
// ==========================================
export global SettingsData {
    callback edit-settings();
}